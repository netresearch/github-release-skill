{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>netresearch/renovate-config"
  ],
  "pre-commit": {
    "enabled": true
  },
  "pep723": {
    "description": "Inline script dependencies of the guard hooks (tree-sitter, tree-sitter-bash); the manager is opt-in",
    "managerFilePatterns": [
      "/^skills/github-release/scripts/guard-[^/]+\\.py$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "uv release installed by the pre-command in script-tests.yml",
      "managerFilePatterns": [
        "/^\\.github/workflows/script-tests\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+UV_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ]
}
